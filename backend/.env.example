# ── ArthaSync Backend — Environment Variables Example ────────────────────────
# Copy this file to .env and fill in your values

# App
ENVIRONMENT=development
SECRET_KEY=your-secret-key-here-change-in-production

# Groq API (get key at https://console.groq.com)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# PostgreSQL — use arthasync_user (created by create_arthasync.sql)
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+asyncpg://arthasync_user:ChangeThisStrongPassword@localhost:5432/arthasync

# CORS — add your frontend URL
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=20

# Zoho Integration 
ZOHO_CLIENT_ID=your_actual_client_id_here
ZOHO_CLIENT_SECRET=your_actual_client_secret_here
ZOHO_REDIRECT_URI=http://localhost:8000/api/zoho/callback
ZOHO_ORG_ID=your_zoho_organization_id_here
ZOHO_REGION=in  # Options: in, eu, com (default)

# Tally Prime Integration (Assumes local installation)
TALLY_HOST=localhost
TALLY_PORT=9000
TALLY_COMPANY=your_tally_company_name_here

# YOLO Object Detection
YOLO_MODEL=yolo26n.pt
YOLO_CONFIDENCE=0.5
YOLO_MAX_DETECTIONS=50
