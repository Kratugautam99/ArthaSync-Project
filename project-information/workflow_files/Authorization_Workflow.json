{
  "name": "Authorization_Workflow",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst body = raw.body ?? raw;  \nlet { username, fullName, email, phone, password } = body;\n\n// Basic presence check\nif (!username || !fullName || !email || !phone || !password) {\n  throw new Error(\"All fields are required: username, fullName, email, phone, password\");\n}\n\n// Email format check\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nif (!emailRegex.test(email)) {\n  throw new Error(\"Invalid email format\");\n}\n\n// Password strength (min 8 chars)\nif (password.length < 8) {\n  throw new Error(\"Password must be at least 8 characters\");\n}\n\n// Phone Number Format Check\nif (phone && !/^\\+[1-9]\\d{0,2}-\\d{7,12}$/.test(phone)) {\n  throw new Error ('Invalid Phone Number — use format +91-9876543210 or +1-2025550100 like +CountryCode-Number');\n}\n\nusername = username.toLowerCase();\nlet phoneSheet = `\\\"${phone}\\\"`\nreturn [{ json: { username, fullName, email, phone, phoneSheet, password } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -704,
        -320
      ],
      "id": "3b28beab-4c7e-47a4-83d7-635f09061f8a",
      "name": "Validate Input"
    },
    {
      "parameters": {
        "jsCode": "const bcrypt = require('bcryptjs');\nconst data = $input.first().json;\n\n// Timestamps\nconst now = new Date();\nconst createdAt = now.toISOString(); // e.g. 2024-04-22T10:30:00.000Z\n\n// Hash password — saltRounds: 12 is a good balance of security vs speed\nconst saltRounds = 12;\nconst hashedPassword = await bcrypt.hash(data.password, saltRounds);\n\nreturn [{\n  json: {\n    username: data.username,\n    fullName: data.fullName,\n    email: data.email,\n    phone: data.phone,\n    createdAt: createdAt,\n    lastLogin: \"never\",\n    hashedPassword: hashedPassword,\n    phoneSheet: $input.first().json.phoneSheet\n    // only goes to DB, NOT to sheet\n  }\n}];"
      },
