    {
      "parameters": {
        "jsCode": "const bcrypt = require('bcryptjs');\n\n// ── Get user row from DB ──────────────────────────────────────────────\nconst user = $('Row Selection from Table').item.json;\n\n// ── Get submitted password (safe read for both live + pinned) ─────────\nconst webhookJson = $('Webhook Trigger [Login]').item.json;\nconst inputPassword = webhookJson.body?.password ?? webhookJson.password;\n\n// ── DEBUG: log what we're working with (remove after confirming it works)\nconsole.log('inputPassword:', inputPassword);\nconsole.log('user keys:', Object.keys(user));\nconsole.log('stored hash:', user.password_hash ?? user.hashedPassword);\n\n// ── Get the hash — check both possible column name spellings ──────────\nconst storedHash = user.password_hash ?? user.hashedPassword;\n\n// ── Guard: if either value is missing, fail clearly ───────────────────\nif (!inputPassword) throw new Error(\"inputPassword is empty — check webhook field name\");\nif (!storedHash)    throw new Error(\"storedHash is empty — check DB column name (password_hash or hashedPassword?)\");\n\n// ── bcrypt compare ────────────────────────────────────────────────────\nconst isMatch = await bcrypt.compare(inputPassword, storedHash);\nconst now = new Date();\nconst last_login = now.toISOString(); \n\nreturn [{\n  json: {\n    isMatch,\n    userId:   user.id,\n    username: user.username,\n    email:    user.email,\n    fullName: user.full_name ?? user.fullName,\n    last_login: last_login\n  }\n}];"
      },
